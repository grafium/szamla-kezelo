{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/cron/rates",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/reminders?digest=daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/reminders?digest=weekly",
      "schedule": "0 6 * * 1"
    }
  ]
}

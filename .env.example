# Adatbázis — fejlesztés alatt SQLite, élesben Postgres
# Postgres példa: postgresql://user:pass@localhost:5432/szamla_kezelo
DATABASE_URL="file:./dev.db"

# NextAuth
AUTH_SECRET="valts-le-egy-hosszu-veletlen-titokra"
AUTH_TRUST_HOST=true

# Cron endpointok védelme (/api/cron/*)
CRON_SECRET="cron-titok"

# Fájlfeltöltés célmappája fejlesztésben
UPLOAD_DIR="./uploads"

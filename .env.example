# Adatbázis — Postgres (pl. Neon: https://neon.tech, az ingyenes tier elég)
# DATABASE_URL: a POOLED (connection pooling) kapcsolati string
# DIRECT_DATABASE_URL: a DIRECT (nem poolozott) string — a séma-műveletekhez (db push)
# A Vercel Neon-integrációja DATABASE_URL és DATABASE_URL_UNPOOLED néven adja
# ugyanezeket — az UNPOOLED értékét másold a DIRECT_DATABASE_URL változóba.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/szamla_kezelo?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/szamla_kezelo?sslmode=require"

# NextAuth — generálás: openssl rand -base64 32
AUTH_SECRET="valts-le-egy-hosszu-veletlen-titokra"
AUTH_TRUST_HOST=true

# Cron endpointok védelme (/api/cron/*). A Vercel Cron automatikusan
# "Authorization: Bearer <CRON_SECRET>" fejléccel hív, ha ez a változó be van állítva.
CRON_SECRET="cron-titok"

# Fájlfeltöltés célmappája fejlesztésben
UPLOAD_DIR="./uploads"
